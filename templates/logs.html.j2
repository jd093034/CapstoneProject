<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Identity Lifecycle Report - Audit & System Logs</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --table-header: #0f172a;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-green: #22c55e;
            --accent-blue: #38bdf8;
            --accent-yellow: #facc15;
            --accent-red: #ef4444;
            --accent-purple: #c084fc;
            --border-color: #334155;
        }

        html, body {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        .container {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .title-area h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
            color: var(--accent-blue);
        }

        .title-area .timestamp {
            color: var(--text-muted);
            font-size: 14px;
        }

        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 0.5px;
            display: inline-block;
            background-color: rgba(56, 189, 248, 0.15);
            color: var(--accent-blue);
            border: 1px solid var(--accent-blue);
        }

        .status-badge.failed {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border-color: var(--accent-red);
        }

        /* Navigation Bar */
        .navbar {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
        }

        .nav-tab {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }

        .nav-tab:hover {
            color: var(--text-main);
            border-color: var(--accent-blue);
        }

        .nav-tab.active {
            color: #0f172a;
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-top: 0;
            margin-bottom: 16px;
            font-size: 18px;
            color: var(--text-main);
            letter-spacing: 0.3px;
        }

        .events-container {
            background-color: #0b1120;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            overflow-x: auto;
        }

        .events-list {
            list-style: none;
            padding: 0;
            margin: 0;
            font-family: "JetBrains Mono", Consolas, monospace;
            font-size: 13px;
            line-height: 1.8;
            white-space: nowrap;
        }

        .events-list li {
            color: #cbd5e1;
            padding: 4px 0;
            border-bottom: 1px solid rgba(51, 65, 85, 0.3);
        }

        .events-list li:last-child {
            border-bottom: none;
        }

        .tag-hired {
            color: var(--accent-green);
            font-weight: bold;
        }

        .tag-transferred {
            color: var(--accent-blue);
            font-weight: bold;
        }

        .tag-terminated {
            color: var(--accent-red);
            font-weight: bold;
        }

        .badge-event {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-status-success {
            background-color: rgba(34, 197, 94, 0.15);
            color: var(--accent-green);
            border: 1px solid var(--accent-green);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        th {
            background-color: var(--table-header);
            color: var(--text-muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        td {
            font-size: 14px;
        }

        .td-nowrap {
            white-space: nowrap;
        }

        /* Pagination Styles */
        .pagination-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .pagination-info {
            font-size: 13px;
            color: var(--text-muted);
        }

        .pagination-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .page-btn {
            background-color: var(--table-header);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .page-btn:hover:not(:disabled) {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .page-btn.active {
            background-color: var(--accent-blue);
            color: #0f172a;
            border-color: var(--accent-blue);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            padding-top: 20px;
            border-top: 1px solid rgba(51, 65, 85, 0.4);
            width: 100%;
            max-width: 1100px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="title-area">
            <h1>HR Identity Lifecycle Report</h1>
            <div class="timestamp">
                {% set hour_12 = ansible_facts['date_time']['hour'] | int % 12 %}
                {% set hour_12 = 12 if hour_12 == 0 else hour_12 %}
                {% set am_pm = 'PM' if (ansible_facts['date_time']['hour'] | int) >= 12 else 'AM' %}
                Generated on {{ ansible_facts['date_time']['date'] }} at {{ "%02d" % hour_12 }}:{{ ansible_facts['date_time']['minute'] }}:{{ ansible_facts['date_time']['second'] }} {{ am_pm }} {{ ansible_facts['date_time']['tz'] }}
            </div>
        </div>
        <div class="status-badge">
            EXECUTION AUDIT LOGS
        </div>
    </div>

    <nav class="navbar">
        <a href="index.html" class="nav-tab">Overview</a>
        <a href="active.html" class="nav-tab">Active Identities</a>
        <a href="disabled.html" class="nav-tab">Disabled Accounts</a>
        <a href="logs.html" class="nav-tab active">Audit & System Logs</a>
    </nav>

    <!-- Raw Event Console Stream -->
    <div class="card">
        <h2>Processed Lifecycle Stream</h2>
        <div class="events-container">
            <ul class="events-list" id="eventsList">
            {% if raw_events | default([]) | length > 0 %}
                {% for event in raw_events %}
                <li class="event-item">
                    {% if 'HIRED' in event %}
                        <span class="tag-hired">[+]</span> {{ event | replace('[+]', '') }}
                    {% elif 'TRANSFERRED' in event %}
                        <span class="tag-transferred">[*]</span> {{ event | replace('[*]', '') }}
                    {% elif 'Offboarded' in event or 'TERMINATED' in event %}
                        <span class="tag-terminated">[-]</span> {{ event | replace('[-]', '') }}
                    {% else %}
                        {{ event }}
                    {% endif %}
                </li>
                {% endfor %}
            {% else %}
                <li>No new events generated in this cycle.</li>
            {% endif %}
            </ul>
        </div>
    </div>

    <!-- Detailed Account Deprovisioning Audit Table -->
    <div class="card">
        <h2>Account Deprovisioning Audit Trail</h2>
        <table id="auditTable">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Target User</th>
                    <th>Event Type</th>
                    <th>Details</th>
                    <th>Executed By</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% if audit_logs | default([]) | length > 0 %}
                    {% for log in audit_logs %}
                    <tr class="table-row">
                        <td class="td-nowrap">{{ (log.timestamp | string | replace('T', ' '))[:19] if log.timestamp is defined else 'N/A' }}</td>
                        <td class="td-nowrap"><code>{{ log.username | default('N/A') }}</code></td>
                        <td class="td-nowrap"><span class="badge-event">{{ log.event_type | default('ACCOUNT_DEPROVISION') }}</span></td>
                        <td>{{ log.details | default('Account disabled and access revoked across AD, Authentik, and PostgreSQL') }}</td>
                        <td class="td-nowrap">{{ log.executed_by | default('Ansible Pipeline') }}</td>
                        <td class="td-nowrap"><span class="badge-status-success">{{ log.status | default('SUCCESS') }}</span></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">
                            No account deprovisioning log entries recorded.
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        {% if audit_logs | default([]) | length > 0 %}
        <div class="pagination-wrapper">
            <div class="pagination-info" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls" id="paginationControls"></div>
        </div>
        {% endif %}
    </div>

    <!-- Pipeline System Telemetry -->
    <div class="card">
        <h2>Pipeline Execution Telemetry</h2>
        <table>
            <thead>
                <tr>
                    <th>Component / Metric</th>
                    <th>Execution Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Pipeline Return Code</td>
                    <td><code>rc={{ sync_result.rc | default(0) }}</code></td>
                </tr>
                <tr>
                    <td>Execution Delta</td>
                    <td><code>{{ sync_result.delta | default('N/A') }}</code></td>
                </tr>
                <tr>
                    <td>PostgreSQL Sync Status</td>
                    <td>
                        {% set pg_stat = postgres_status | default('SUCCESS') %}
                        <span class="status-badge {% if pg_stat == 'FAILED' %}failed{% endif %}">{{ pg_stat }}</span>
                    </td>
                </tr>
                <tr>
                    <td>Authentik SSO Sync Status</td>
                    <td>
                        {% set auth_stat = authentik_status | default('SUCCESS') %}
                        <span class="status-badge {% if auth_stat == 'FAILED' %}failed{% endif %}">{{ auth_stat }}</span>
                    </td>
                </tr>
                <tr>
                    <td>Active Directory Sync Status</td>
                    <td>
                        {% set ad_stat = ad_status | default('SUCCESS') %}
                        <span class="status-badge {% if ad_stat == 'FAILED' %}failed{% endif %}">{{ ad_stat }}</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="footer">
    Automated HR Identity Management Pipeline • Nginx Service Active
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const rowsPerPage = 10;
    const tableBody = document.querySelector("#auditTable tbody");
    if (!tableBody) return;

    const rows = Array.from(tableBody.querySelectorAll("tr.table-row"));
    const totalRows = rows.length;

    if (totalRows === 0) return;

    let currentPage = 1;
    const totalPages = Math.ceil(totalRows / rowsPerPage);

    function displayPage(page) {
        currentPage = page;
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        rows.forEach((row, index) => {
            if (index >= start && index < end) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });

        const currentEnd = Math.min(end, totalRows);
        const infoElem = document.getElementById("paginationInfo");
        if (infoElem) {
            infoElem.innerText = `Showing ${start + 1} to ${currentEnd} of ${totalRows} entries`;
        }

        renderControls();
    }

    function renderControls() {
        const controlsContainer = document.getElementById("paginationControls");
        if (!controlsContainer) return;

        controlsContainer.innerHTML = "";

        const prevBtn = document.createElement("button");
        prevBtn.className = "page-btn";
        prevBtn.innerText = "‹ Prev";
        prevBtn.disabled = currentPage === 1;
        prevBtn.onclick = () => displayPage(currentPage - 1);
        controlsContainer.appendChild(prevBtn);

        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) {
            startPage = Math.max(1, endPage - 4);
        }

        for (let i = startPage; i <= endPage; i++) {
            const pageBtn = document.createElement("button");
            pageBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
            pageBtn.innerText = i;
            pageBtn.onclick = () => displayPage(i);
            controlsContainer.appendChild(pageBtn);
        }

        const nextBtn = document.createElement("button");
        nextBtn.className = "page-btn";
        nextBtn.innerText = "Next ›";
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.onclick = () => displayPage(currentPage + 1);
        controlsContainer.appendChild(nextBtn);
    }

    displayPage(1);
});
</script>

</body>
</html>