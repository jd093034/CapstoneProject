<!-- Tells the web browser this is a modern HTML5 webpage -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Sets character encoding so special symbols (like •, ‹, ›) render properly -->
    <meta charset="UTF-8">
    <!-- Makes the layout scale cleanly on laptops, tablets, and phones -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Title shown on the browser tab -->
    <title>HR Identity Lifecycle Report - Audit & System Logs</title>
    <style>
        /* ":root" stores reusable color swatches (--variable-name) so our dark-mode theme
           stays consistent across the entire dashboard without repeating hex color codes. */
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --table-header: #0f172a;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-green: #22c55e;
            --accent-blue: #38bdf8;
            --accent-yellow: #facc15;
            --accent-red: #ef4444;
            --accent-purple: #c084fc;
            --border-color: #334155;
        }

        /* Base page styling: dark slate background, light text, and clean system fonts */
        html, body {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        /* Flexbox centers the dashboard and pushes the footer cleanly to the bottom of the screen */
        body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        /* Limits dashboard width to 1100px so wide audit tables and terminal logs stay easy to read */
        .container {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
        }

        /* Top title bar: pushes the page title to the left and the blue EXECUTION AUDIT LOGS badge to the right */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .title-area h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
            color: var(--accent-blue);
        }

        .title-area .timestamp {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Pill-shaped blue badge in the top-right (and green SUCCESS pills in the telemetry table) */
        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 0.5px;
            display: inline-block;
            background-color: rgba(56, 189, 248, 0.15);
            color: var(--accent-blue);
            border: 1px solid var(--accent-blue);
        }

        /* Turns any status badge red automatically when a backend service reports FAILED */
        .status-badge.failed {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border-color: var(--accent-red);
        }

        /* Navigation Bar linking all 4 static HTML dashboard pages */
        .navbar {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
        }

        .nav-tab {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }

        .nav-tab:hover {
            color: var(--text-main);
            border-color: var(--accent-blue);
        }

        /* Highlights whichever page tab the user is currently viewing */
        .nav-tab.active {
            color: #0f172a;
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        /* Rounded container boxes used for each log/audit section */
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-top: 0;
            margin-bottom: 16px;
            font-size: 18px;
            color: var(--text-main);
            letter-spacing: 0.3px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Thick red left border highlighting the Desync Remediation Queue whenever errors occur */
        .remediation-card {
            border-left: 4px solid var(--accent-red);
        }

        .remediation-badge {
            background-color: rgba(239, 68, 68, 0.2);
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Top bar above the terminal log box holding category filter buttons + live search bar */
        .log-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background-color: #0b1120;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .filter-btn:hover {
            color: var(--text-main);
            border-color: var(--accent-blue);
        }

        .filter-btn.active {
            background-color: var(--accent-blue);
            color: #0f172a;
            border-color: var(--accent-blue);
        }

        /* Live keyword search input box for filtering terminal log lines */
        .search-input {
            background-color: #0b1120;
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 12px;
            min-width: 240px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .search-input:focus {
            border-color: var(--accent-blue);
        }

        /* Fixed-height (450px) scrollable dark terminal box so 1,000+ log lines don't stretch the page */
        .events-container {
            background-color: #0b1120;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            max-height: 450px;
            overflow-y: auto;
        }

        .events-list {
            list-style: none;
            padding: 0;
            margin: 0;
            font-family: "JetBrains Mono", Consolas, monospace;
            font-size: 13px;
            line-height: 1.8;
            white-space: nowrap;
        }

        .events-list li {
            color: #cbd5e1;
            padding: 4px 0;
            border-bottom: 1px solid rgba(51, 65, 85, 0.3);
        }

        .events-list li:last-child {
            border-bottom: none;
        }

        /* Color-coded log prefixes: green [+], yellow [*], red [-], and highlighted red [!] */
        .tag-hired { color: var(--accent-green); font-weight: bold; }
        .tag-transferred { color: var(--accent-yellow); font-weight: bold; }
        .tag-terminated { color: var(--accent-red); font-weight: bold; }
        .tag-error { color: var(--accent-red); font-weight: bold; background: rgba(239,68,68,0.15); padding: 2px 6px; border-radius: 3px; }

        /* Red pill badge for TERMINATION events in the audit table */
        .badge-event {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Green pill badge for COMPLETED audit rows */
        .badge-status-success {
            background-color: rgba(34, 197, 94, 0.15);
            color: var(--accent-green);
            border: 1px solid var(--accent-green);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Full-width data table styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        th {
            background-color: var(--table-header);
            color: var(--text-muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        td {
            font-size: 14px;
        }

        .td-nowrap {
            white-space: nowrap;
        }

        /* Dark monospace pill tag used to highlight usernames inside audit tables */
        .code-tag {
            font-family: "JetBrains Mono", Consolas, monospace;
            background-color: #0b1120;
            padding: 3px 8px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            font-size: 12px;
            color: var(--accent-blue);
        }

        /* Bottom bar holding "Showing 1 to 10 of X entries" on the left and page buttons on the right */
        .pagination-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .pagination-info {
            font-size: 13px;
            color: var(--text-muted);
        }

        .pagination-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .page-btn {
            background-color: var(--table-header);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .page-btn:hover:not(:disabled) {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .page-btn.active {
            background-color: var(--accent-blue);
            color: #0f172a;
            border-color: var(--accent-blue);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            padding-top: 20px;
            border-top: 1px solid rgba(51, 65, 85, 0.4);
            width: 100%;
            max-width: 1100px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="title-area">
            <h1>HR Identity Lifecycle Report</h1>
            <div class="timestamp">
                {# Jinja2 logic ({% ... %}): converts Ansible's 24-hour military clock into a 12-hour AM/PM clock. #}
                {# "% 12" gets the remainder after dividing by 12 (so 14:00 becomes 2); midnight/noon (0) becomes 12. #}
                {% set hour_12 = ansible_facts['date_time']['hour'] | int % 12 %}
                {% set hour_12 = 12 if hour_12 == 0 else hour_12 %}
                {% set am_pm = 'PM' if (ansible_facts['date_time']['hour'] | int) >= 12 else 'AM' %}
                {# "%02d" pads single-digit hours with a leading zero (e.g., "02:05:09 PM") #}
                Generated on {{ ansible_facts['date_time']['date'] }} at {{ "%02d" % hour_12 }}:{{ ansible_facts['date_time']['minute'] }}:{{ ansible_facts['date_time']['second'] }} {{ am_pm }} {{ ansible_facts['date_time']['tz'] }}
            </div>
        </div>
        <div class="status-badge">
            EXECUTION AUDIT LOGS
        </div>
    </div>

    <!-- Top navigation tabs connecting all 4 static HTML dashboard pages -->
    <nav class="navbar">
        <a href="index.html" class="nav-tab">Overview</a>
        <a href="active.html" class="nav-tab">Active Identities</a>
        <a href="disabled.html" class="nav-tab">Disabled Accounts</a>
        <a href="logs.html" class="nav-tab active">Audit & System Logs</a>
    </nav>

    <!-- 1. Desync & Manual Remediation Exception Queue (only appears if a user failed verification) -->
    {# Combine disabled + active mismatch lists for Active Directory and Authentik SSO.
       "| unique" removes duplicate usernames so someone isn't counted twice. #}
    {% set all_ad_mismatches = (ad_mismatch_list | default([])) + (active_ad_mismatch_list | default([])) %}
    {% set all_ak_mismatches = (authentik_mismatch_list | default([])) + (active_authentik_mismatch_list | default([])) %}
    {% set total_failed_users = (all_ad_mismatches + all_ak_mismatches) | unique %}

    {# Conditional alert table: completely hidden during 100% healthy runs; appears automatically if any mismatch exists #}
    {% if total_failed_users | length > 0 %}
    <div class="card remediation-card">
        <h2>
            <span>Desync & Manual Remediation Exception Queue</span>
            <span class="remediation-badge">{{ total_failed_users | length }} Flagged Errors</span>
        </h2>
        <p style="font-size: 13px; color: var(--text-muted); margin-top: 0; margin-bottom: 16px;">
            The following managed identities failed live downstream endpoint verification and require direct IT administrative intervention.
        </p>
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Target System</th>
                    <th>Failure Classification</th>
                    <th>Remediation Status</th>
                </tr>
            </thead>
            <tbody>
                {# List any user whose Active Directory state didn't match PostgreSQL #}
                {% for uname in all_ad_mismatches | unique %}
                <tr>
                    <td><span class="code-tag">{{ uname }}</span></td>
                    <td><strong style="color: var(--accent-yellow);">Active Directory</strong></td>
                    <td>Missing or Disabled Account in Domain OU</td>
                    <td><span class="remediation-badge">ACTION REQUIRED</span></td>
                </tr>
                {% endfor %}
                {# List any user whose Authentik SSO state didn't match PostgreSQL #}
                {% for uname in all_ak_mismatches | unique %}
                <tr>
                    <td><span class="code-tag">{{ uname }}</span></td>
                    <td><strong style="color: var(--accent-purple);">Authentik SSO</strong></td>
                    <td>REST Directory Account State Mismatch</td>
                    <td><span class="remediation-badge">ACTION REQUIRED</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <!-- 2. Processed Lifecycle Stream (Search + Category Filter + 450px Fixed Scrollbox) -->
    <div class="card">
        <h2>
            <span>Processed Lifecycle Stream</span>
            <span id="logCounter" style="font-size: 12px; color: var(--text-muted); font-weight: normal;">
                Showing 0 of 0 log entries
            </span>
        </h2>

        <!-- Interactive toolbar: clicking a button filters by event type; typing in the search box filters in real time -->
        <div class="log-toolbar">
            <div class="filter-group">
                <button class="filter-btn active" onclick="setLogFilter('ALL', this)">All Logs</button>
                <button class="filter-btn" onclick="setLogFilter('HIRED', this)">Hires</button>
                <button class="filter-btn" onclick="setLogFilter('TRANSFERRED', this)">Transfers</button>
                <button class="filter-btn" onclick="setLogFilter('TERMINATED', this)">Terminations</button>
                <button class="filter-btn" onclick="setLogFilter('ERROR', this)">Errors</button>
            </div>
            <input type="text" id="logSearchInput" placeholder="Filter logs (username, department)..." class="search-input" onkeyup="filterLogStream()">
        </div>

        <!-- Scrollable terminal-style log box populated dynamically by renderLogStream() in JavaScript below -->
        <div class="events-container">
            <ul class="events-list" id="eventsList">
                <!-- Rendered dynamically by JS -->
            </ul>
        </div>
    </div>

    <!-- 3. Detailed Account Deprovisioning Audit Table -->
    <div class="card">
        <h2>Account Deprovisioning Audit Trail</h2>
        <table id="auditTable">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Target User</th>
                    <th>Event Type</th>
                    <th>Details</th>
                    <th>Executed By</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {# Loop through every terminated user from PostgreSQL and render a permanent compliance audit row #}
                {% if dynamic_inactive_users is defined and dynamic_inactive_users | length > 0 %}
                    {% for u in dynamic_inactive_users %}
                    <tr class="table-row">
                        <td class="td-nowrap">{{ u.terminated_at | default('N/A') }}</td>
                        <td class="td-nowrap"><span class="code-tag">{{ u.username }}</span></td>
                        <td class="td-nowrap"><span class="badge-event">TERMINATION</span></td>
                        <td>Account disabled and access revoked across AD, Authentik, and PostgreSQL</td>
                        <td class="td-nowrap">Ansible Pipeline</td>
                        <td class="td-nowrap"><span class="badge-status-success">COMPLETED</span></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    {# Empty-state row shown when no account deprovisionings have been recorded yet #}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">
                            No account deprovisioning log entries recorded.
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        <!-- Hidden by default; JavaScript reveals this pagination bar if the audit table has rows -->
        <div class="pagination-wrapper" id="auditPaginationWrapper" style="display: none;">
            <div class="pagination-info" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls" id="paginationControls"></div>
        </div>
    </div>

    <!-- 4. Pipeline System Telemetry (shows Ansible exit code, stopwatch runtime, and per-system health) -->
    <div class="card">
        <h2>Pipeline Execution Telemetry</h2>
        <table>
            <thead>
                <tr>
                    <th>Component / Metric</th>
                    <th>Execution Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Pipeline Return Code</td>
                    <!-- "rc=0" is Linux/Ansible's standard exit code meaning the entire run finished with zero errors -->
                    <td><code>rc={{ sync_result.rc | default(0) }}</code></td>
                </tr>
                <tr>
                    <td>Execution Delta</td>
                    <!-- Total elapsed time measured by Ansible's internal stopwatch (HH:MM:SS.mmmmmm) -->
                    <td><code>{{ sync_result.delta | default('N/A') }}</code></td>
                </tr>
                <tr>
                    <td>PostgreSQL Sync Status</td>
                    <td>
                        {% set pg_stat = postgres_status | default('SUCCESS') %}
                        <span class="status-badge {% if pg_stat == 'FAILED' %}failed{% endif %}">{{ pg_stat }}</span>
                    </td>
                </tr>
                <tr>
                    <td>Authentik SSO Sync Status</td>
                    <td>
                        {% set auth_stat = authentik_status | default('SUCCESS') %}
                        <span class="status-badge {% if auth_stat == 'FAILED' %}failed{% endif %}">{{ auth_stat }}</span>
                    </td>
                </tr>
                <tr>
                    <td>Active Directory Sync Status</td>
                    <td>
                        {% set ad_stat = ad_status | default('SUCCESS') %}
                        <span class="status-badge {% if ad_stat == 'FAILED' %}failed{% endif %}">{{ ad_stat }}</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="footer">
    Automated HR Identity Management Pipeline • Nginx Service Active
</div>

<script>
    // "| to_json" converts Ansible's raw_events Python list directly into a native JavaScript array
    // right inside the HTML file so the browser can filter and search all log lines instantaneously.
    const rawLogData = {{ raw_events | default([]) | to_json }};
    let activeLogCategory = 'ALL';

    // Filters rawLogData by both the selected category button AND the text typed in the search box,
    // then color-codes each log line inside the terminal scrollbox.
    function renderLogStream() {
        const eventsList = document.getElementById('eventsList');
        const searchVal = document.getElementById('logSearchInput').value.toLowerCase();
        const logCounter = document.getElementById('logCounter');

        // Show a clean placeholder message if the pipeline didn't emit any new events
        if (!rawLogData || rawLogData.length === 0) {
            eventsList.innerHTML = '<li style="color: var(--text-muted); text-align: center;">No new events generated in this cycle.</li>';
            logCounter.innerText = 'Showing 0 of 0 log entries';
            return;
        }

        // Keep only log lines that match BOTH the active category button and the search keyword
        const filtered = rawLogData.filter(line => {
            const lineUpper = line.toUpperCase();
            let matchesCategory = true;

            if (activeLogCategory === 'HIRED') matchesCategory = lineUpper.includes('HIRED:');
            else if (activeLogCategory === 'TRANSFERRED') matchesCategory = lineUpper.includes('TRANSFERRED:');
            else if (activeLogCategory === 'TERMINATED') matchesCategory = lineUpper.includes('TERMINATED:') || lineUpper.includes('OFFBOARDED:');
            else if (activeLogCategory === 'ERROR') matchesCategory = lineUpper.includes('ERROR') || lineUpper.includes('FAILED') || lineUpper.includes('EXCEPTION');

            const matchesSearch = line.toLowerCase().includes(searchVal);
            return matchesCategory && matchesSearch;
        });

        // Build the HTML list items with color-coded [+] / [*] / [-] / [!] status tags
        if (filtered.length === 0) {
            eventsList.innerHTML = '<li style="color: var(--text-muted); text-align: center;">No log entries match the selected filter or search query.</li>';
        } else {
            eventsList.innerHTML = filtered.map(line => {
                let tagHtml = '';
                // Sanitize text with escapeHtml() first so special characters don't break HTML rendering
                let cleanLine = escapeHtml(line);

                if (line.includes('HIRED:')) {
                    tagHtml = '<span class="tag-hired">[+]</span> ';
                    cleanLine = cleanLine.replace('[+]', '');
                } else if (line.includes('TRANSFERRED:')) {
                    tagHtml = '<span class="tag-transferred">[*]</span> ';
                    cleanLine = cleanLine.replace('[*]', '');
                } else if (line.includes('TERMINATED:') || line.includes('Offboarded')) {
                    tagHtml = '<span class="tag-terminated">[-]</span> ';
                    cleanLine = cleanLine.replace('[-]', '');
                } else if (line.includes('ERROR') || line.includes('FAILED')) {
                    tagHtml = '<span class="tag-error">[!]</span> ';
                }

                return `<li>${tagHtml}${cleanLine}</li>`;
            }).join('');
        }

        // Update the "Showing X of Y log entries" counter in the card header
        logCounter.innerText = `Showing ${filtered.length} of ${rawLogData.length} log entries`;
    }

    // Called when a user clicks one of the filter buttons (All Logs, Hires, Transfers, Terminations, Errors)
    function setLogFilter(category, btnElem) {
        activeLogCategory = category;
        // Move the blue "active" highlight to whichever button was just clicked
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        btnElem.classList.add('active');
        renderLogStream();
    }

    // Called on every keystroke inside the search input box
    function filterLogStream() {
        renderLogStream();
    }

    // Safety helper: converts &, <, and > into safe HTML codes so log text can never accidentally
    // inject broken HTML tags into the page.
    function escapeHtml(text) {
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    /* Deprovisioning Audit Table Client-Side Pagination */
    // Runs as soon as the webpage finishes loading: renders the initial log stream and slices
    // the deprovisioning audit table into 10-row pages.
    document.addEventListener("DOMContentLoaded", function() {
        renderLogStream();

        const rowsPerPage = 10;
        const tableBody = document.querySelector("#auditTable tbody");
        if (!tableBody) return;

        // Grab every rendered audit row (<tr class="table-row">) and convert into a JavaScript array
        const rows = Array.from(tableBody.querySelectorAll("tr.table-row"));
        const totalRows = rows.length;

        // Leave the pagination bar hidden if there are no audit rows yet
        if (totalRows === 0) return;

        document.getElementById("auditPaginationWrapper").style.display = "flex";
        let currentPage = 1;
        // Math.ceil rounds up so e.g. 25 audit rows becomes 3 pages (10 + 10 + 5)
        const totalPages = Math.ceil(totalRows / rowsPerPage);

        // Shows only the 10 rows belonging to the selected page number and hides all others
        function displayPage(page) {
            currentPage = page;
            // Calculate first and last row index for this page (Page 1 = rows 0..9, Page 2 = rows 10..19)
            const start = (page - 1) * rowsPerPage;
            const end = start + rowsPerPage;

            rows.forEach((row, index) => {
                row.style.display = (index >= start && index < end) ? "" : "none";
            });

            // Update the "Showing 1 to 10 of X entries" text label
            const currentEnd = Math.min(end, totalRows);
            const infoElem = document.getElementById("paginationInfo");
            if (infoElem) {
                infoElem.innerText = `Showing ${start + 1} to ${currentEnd} of ${totalRows} entries`;
            }

            // Redraw the page buttons to highlight the newly active page
            renderControls();
        }

        // Dynamically creates the "< Prev", numbered page buttons, and "Next >" buttons
        function renderControls() {
            const controlsContainer = document.getElementById("paginationControls");
            if (!controlsContainer) return;
            controlsContainer.innerHTML = "";

            // "< Prev" button (disabled on Page 1)
            const prevBtn = document.createElement("button");
            prevBtn.className = "page-btn";
            prevBtn.innerText = "‹ Prev";
            prevBtn.disabled = currentPage === 1;
            prevBtn.onclick = () => displayPage(currentPage - 1);
            controlsContainer.appendChild(prevBtn);

            // Sliding window: keeps at most 5 page buttons visible at once so large audit logs don't overflow
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }

            // Create each numbered page button and highlight the active page in blue
            for (let i = startPage; i <= endPage; i++) {
                const pageBtn = document.createElement("button");
                pageBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
                pageBtn.innerText = i;
                pageBtn.onclick = () => displayPage(i);
                controlsContainer.appendChild(pageBtn);
            }

            // "Next >" button (disabled on the final page)
            const nextBtn = document.createElement("button");
            nextBtn.className = "page-btn";
            nextBtn.innerText = "Next ›";
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.onclick = () => displayPage(currentPage + 1);
            controlsContainer.appendChild(nextBtn);
        }

        // Display Page 1 immediately when the page loads
        displayPage(1);
    });
</script>

</body>
</html>