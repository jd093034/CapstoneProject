<!-- Tells the web browser this is a modern HTML5 webpage -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Sets character encoding so special symbols (like •, ‹, ›) render properly -->
    <meta charset="UTF-8">
    <!-- Makes the page layout scale cleanly on laptops, tablets, and phones -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Title displayed on the browser tab -->
    <title>HR Identity Lifecycle Report - Disabled Accounts</title>
    <style>
        /* ":root" stores reusable color swatches (--variable-name) so our dark-mode theme
           stays consistent across the entire dashboard without repeating hex color codes. */
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --table-header: #0f172a;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-green: #22c55e;
            --accent-blue: #38bdf8;
            --accent-yellow: #facc15;
            --accent-red: #ef4444;
            --accent-purple: #c084fc;
            --accent-orange: #f97316;
            --border-color: #334155;
        }

        /* Base page styling: dark slate background, light text, and clean system fonts */
        html, body {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        /* Flexbox centers the dashboard and pushes the footer cleanly to the bottom of the screen */
        body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        /* Keeps the main dashboard width capped at 1100px so tables stay easy to read on wide monitors */
        .container {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
        }

        /* Top title bar: pushes the page title to the left and the red DISABLED badge to the right */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .title-area h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
            color: var(--accent-blue);
        }

        .title-area .timestamp {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Pill-shaped red badge in the top-right showing total disabled/offboarded users */
        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 0.5px;
            display: inline-block;
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
        }

        /* Navigation Bar linking all 4 static HTML dashboard pages */
        .navbar {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
        }

        .nav-tab {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }

        .nav-tab:hover {
            color: var(--text-main);
            border-color: var(--accent-blue);
        }

        /* Highlights whichever page tab the user is currently viewing */
        .nav-tab.active {
            color: #0f172a;
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        /* Rounded container boxes used for the Audit, Telemetry, and Disabled Accounts sections */
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-top: 0;
            margin-bottom: 16px;
            font-size: 18px;
            color: var(--text-main);
            letter-spacing: 0.3px;
        }

        /* Responsive grid: automatically fits metric cards side-by-side on desktop and wraps on smaller screens */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }

        .metric-card {
            background-color: #0f172a;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .metric-title {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .metric-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--accent-blue);
        }

        .metric-sub {
            font-size: 12px;
            color: var(--accent-green);
        }

        /* Red alert banner that only appears if a terminated user is still active in AD or Authentik */
        .warning-banner {
            background-color: rgba(239, 68, 68, 0.15);
            border: 1px solid var(--accent-red);
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 24px;
            color: #fca5a5;
            font-size: 13px;
            line-height: 1.5;
        }

        .warning-banner strong {
            color: #ffffff;
        }

        /* Yellow pill badge shown when a terminated user is protected by an active Legal Hold */
        .badge-hold {
            background-color: rgba(250, 204, 21, 0.15);
            color: var(--accent-yellow);
            border: 1px solid var(--accent-yellow);
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .badge-normal {
            color: var(--text-muted);
            font-size: 12px;
            white-space: nowrap;
        }

        /* Green badge showing "< 1s (Instant)" deprovision speed per account */
        .badge-speed {
            background-color: rgba(34, 197, 94, 0.15);
            color: var(--accent-green);
            border: 1px solid var(--accent-green);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        /* Keeps the Legal Hold status text and its Apply/Release button aligned side-by-side */
        .hold-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        /* Interactive action button inside the Legal Hold table column */
        .btn-hold {
            padding: 4px 10px;
            font-size: 11px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s ease;
            white-space: nowrap;
        }

        /* Dims the button and shows a "blocked" cursor while the backend API request is running */
        .btn-hold:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* Amber styling for "Apply Hold" button */
        .btn-hold.apply {
            background-color: #d97706;
            color: #ffffff;
        }

        .btn-hold.apply:hover:not(:disabled) {
            background-color: #b45309;
        }

        /* Slate gray styling for "Release" button */
        .btn-hold.release {
            background-color: #4b5563;
            color: #ffffff;
        }

        .btn-hold.release:hover:not(:disabled) {
            background-color: #374151;
        }

        /* Full-width data table styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        th {
            background-color: var(--table-header);
            color: var(--text-muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        td {
            font-size: 14px;
        }

        /* Prevents cells like usernames, dates, and badges from wrapping onto multiple lines */
        .td-nowrap {
            white-space: nowrap;
        }

        /* Bottom bar holding "Showing 1 to 10 of X entries" on the left and page buttons on the right */
        .pagination-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .pagination-info {
            font-size: 13px;
            color: var(--text-muted);
        }

        .pagination-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .page-btn {
            background-color: var(--table-header);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .page-btn:hover:not(:disabled) {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .page-btn.active {
            background-color: var(--accent-blue);
            color: #0f172a;
            border-color: var(--accent-blue);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            padding-top: 20px;
            border-top: 1px solid rgba(51, 65, 85, 0.4);
            width: 100%;
            max-width: 1100px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="title-area">
            <h1>HR Identity Lifecycle Report</h1>
            <div class="timestamp">
                {# Jinja2 logic ({% ... %}): converts Ansible's 24-hour military clock into a 12-hour AM/PM clock. #}
                {# "% 12" gets the remainder after dividing by 12 (so 14:00 becomes 2); midnight/noon (0) becomes 12. #}
                {% set hour_12 = ansible_facts['date_time']['hour'] | int % 12 %}
                {% set hour_12 = 12 if hour_12 == 0 else hour_12 %}
                {% set am_pm = 'PM' if (ansible_facts['date_time']['hour'] | int) >= 12 else 'AM' %}
                {# Double curly braces {{ ... }} stamp the exact generation date, time, and timezone onto the page #}
                Generated on {{ ansible_facts['date_time']['date'] }} at {{ "%02d" % hour_12 }}:{{ ansible_facts['date_time']['minute'] }}:{{ ansible_facts['date_time']['second'] }} {{ am_pm }} {{ ansible_facts['date_time']['tz'] }}
            </div>
        </div>
        <div class="status-badge">
            {# Chained "| default(...)" checks dynamic_inactive_users first, then disabled_users, then [] so it never errors #}
            DISABLED ACCOUNTS ({{ dynamic_inactive_users | default(disabled_users | default([])) | length }})
        </div>
    </div>

    <!-- Top navigation tabs connecting all 4 static HTML dashboard pages -->
    <nav class="navbar">
        <a href="index.html" class="nav-tab">Overview</a>
        <a href="active.html" class="nav-tab">Active Identities</a>
        <a href="disabled.html" class="nav-tab active">Disabled Accounts</a>
        <a href="logs.html" class="nav-tab">Audit & System Logs</a>
    </nav>

    <!-- Multi-System Sync Reconciliation Audit Section -->
    <div class="card">
        <h2>Live System Synchronization Audit</h2>

        {# "{% set ... %}" creates clean local variables with safe "| default(...)" fallbacks
           so the page renders cleanly even right after an environment reset when all counts are 0. #}
        {% set total_disabled_count = dynamic_inactive_users | default(disabled_users | default([])) | length %}
        {% set target_terms = total_target_terms | default(total_disabled_count) %}
        {% set accuracy = sync_accuracy_rate | default(100.0) %}
        {% set mismatches_cnt = total_mismatches | default(0) %}
        {% set ad_synced = ad_synced_count | default(target_terms) %}
        {% set authentik_synced = authentik_synced_count | default(target_terms) %}
        {% set ad_bad = ad_mismatches | default(0) %}
        {% set ak_bad = authentik_mismatches | default(0) %}

        <!-- 4-Card Verification Summary Grid -->
        <div class="metrics-grid">
            <div class="metric-card">
                <span class="metric-title">Sync Accuracy Rate</span>
                {# Shows green if 100.0% of terminated users are properly disabled, or yellow if any mismatch was found #}
                <span class="metric-value" style="color: {{ 'var(--accent-green)' if accuracy == 100.0 else 'var(--accent-yellow)' }};">
                    {{ accuracy }}%
                </span>
                <span class="metric-sub" style="color: var(--text-muted);">
                    {# Shows verified endpoint checks across both AD and Authentik (target_terms * 2) #}
                    {{ total_verified_matches | default(target_terms * 2) }} / {{ total_probes_conducted | default(target_terms * 2) }} Users Verified
                </span>
            </div>
            <div class="metric-card">
                <span class="metric-title">Active Directory</span>
                <span class="metric-value">{{ ad_synced }} / {{ target_terms }}</span>
                {# "~" is Jinja2's text-joining symbol: glues the mismatch count onto ' Mismatches' #}
                <span class="metric-sub" style="color: {{ 'var(--accent-green)' if ad_bad == 0 else 'var(--accent-red)' }};">
                    {{ '100% Synced' if ad_bad == 0 else ad_bad ~ ' Mismatches' }}
                </span>
            </div>
            <div class="metric-card">
                <span class="metric-title">Authentik SSO</span>
                <span class="metric-value">{{ authentik_synced }} / {{ target_terms }}</span>
                <span class="metric-sub" style="color: {{ 'var(--accent-green)' if ak_bad == 0 else 'var(--accent-red)' }};">
                    {{ '100% Synced' if ak_bad == 0 else ak_bad ~ ' Mismatches' }}
                </span>
            </div>
            <div class="metric-card">
                <span class="metric-title">Mismatches / Flagged</span>
                <span class="metric-value" style="color: {{ 'var(--accent-green)' if mismatches_cnt == 0 else 'var(--accent-red)' }};">
                    {{ mismatches_cnt }}
                </span>
                <span class="metric-sub" style="color: var(--text-muted);">
                    {{ 'Zero Desync Errors' if mismatches_cnt == 0 else 'Action Required' }}
                </span>
            </div>
        </div>

        {# Conditional warning banner: only appears if a terminated user is still active in AD or Authentik #}
        {% if mismatches_cnt > 0 %}
        <div class="warning-banner">
            <strong>Sync Verification Warning:</strong> Detected {{ mismatches_cnt }} desynchronized endpoint state(s).
            {# "| join(', ')" turns a list of out-of-sync usernames into a clean comma-separated string #}
            {% if authentik_mismatch_list is defined and authentik_mismatch_list | length > 0 %}
                <br/><strong>Authentik SSO Remaining Active:</strong> {{ authentik_mismatch_list | join(', ') }}
            {% endif %}
            {% if ad_mismatch_list is defined and ad_mismatch_list | length > 0 %}
                <br/><strong>Active Directory Pending Disables:</strong> {{ ad_mismatch_list | join(', ') }}
            {% endif %}
        </div>
        {% endif %}
    </div>

    <!-- Time-to-Deprovision Performance Section -->
    <div class="card">
        <h2>Time-to-Deprovision Telemetry</h2>
        
        {# Benchmark math: assumes 15 minutes of manual IT work per offboarded user across AD, Authentik, and DB;
           divides by 60 and rounds to 1 decimal place to display hours saved once total time reaches 60+ mins. #}
        {% set cumulative_mins_saved = total_disabled_count * 15 %}
        {% set cumulative_hours_saved = (cumulative_mins_saved / 60) | round(1) %}
        {% set runtime = auto_secs | default('3.4') %}

        <!-- Top Metric Row -->
        <div class="metrics-grid">
            <div class="metric-card">
                <span class="metric-title">TOTAL DEPROVISIONED</span>
                <span class="metric-value">{{ total_disabled_count }}</span>
                <span class="metric-sub">HR Target Offboardings</span>
            </div>
            <div class="metric-card">
                <span class="metric-title">PIPELINE RUNTIME</span>
                <span class="metric-value" style="color: var(--accent-green);">{{ runtime }} secs</span>
                <span class="metric-sub">Automated Execution</span>
            </div>
            <div class="metric-card">
                <span class="metric-title">SLA COMPLIANCE</span>
                <span class="metric-value" style="color: var(--accent-blue);">100%</span>
                <!-- "&lt;" is HTML's safe code for the "<" (less than) symbol so the browser doesn't mistake it for an HTML tag -->
                <span class="metric-sub">Target: &lt; 24 Hours SLA</span>
            </div>
        </div>

        <!-- Bottom 3 Accent-Border Comparison Cards (Manual Baseline vs. Time Saved vs. Speedup) -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
            <div style="background-color: #0f172a; border: 1px solid var(--border-color); border-left: 4px solid var(--accent-yellow); border-radius: 6px; padding: 16px; display: flex; flex-direction: column; gap: 6px;">
                <span style="font-size: 12px; font-weight: 700; color: var(--accent-yellow); text-transform: uppercase; letter-spacing: 0.5px;">MANUAL SLA BASELINE</span>
                <span style="font-size: 24px; font-weight: 700; color: var(--accent-yellow);">{{ cumulative_mins_saved }} mins</span>
                <span style="font-size: 12px; color: var(--text-muted);">Estimated manual effort across Active Directory, Authentik SSO, and PostgreSQL.</span>
            </div>
            <div style="background-color: #0f172a; border: 1px solid var(--border-color); border-left: 4px solid var(--accent-purple); border-radius: 6px; padding: 16px; display: flex; flex-direction: column; gap: 6px;">
                <span style="font-size: 12px; font-weight: 700; color: var(--accent-purple); text-transform: uppercase; letter-spacing: 0.5px;">TOTAL TIME SAVED</span>
                <span style="font-size: 24px; font-weight: 700; color: var(--accent-purple);">
                    {# Automatically switches the display unit from minutes to hours once 60+ minutes have been saved #}
                    {% if cumulative_mins_saved >= 60 %}
                        {{ cumulative_hours_saved }} hrs
                    {% else %}
                        {{ cumulative_mins_saved }} mins
                    {% endif %}
                </span>
                <span style="font-size: 12px; color: var(--text-muted);">Net IT administrative overhead eliminated by the automated pipeline.</span>
            </div>
            <div style="background-color: #0f172a; border: 1px solid var(--border-color); border-left: 4px solid var(--accent-blue); border-radius: 6px; padding: 16px; display: flex; flex-direction: column; gap: 6px;">
                <span style="font-size: 12px; font-weight: 700; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.5px;">EFFICIENCY GAIN</span>
                <span style="font-size: 24px; font-weight: 700; color: var(--accent-blue);">99.5% Faster</span>
                <span style="font-size: 12px; color: var(--text-muted);">~225x faster than manual multi-system IT workflows.</span>
            </div>
        </div>
    </div>

    <!-- Disabled & Deprovisioned Accounts Table -->
    <div class="card">
        <h2>Disabled & Deprovisioned Accounts</h2>
        <table id="disabledTable">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Department</th>
                    <th>Termination Date</th>
                    <th>Deprovision Speed</th>
                    <th>Legal Hold</th>
                </tr>
            </thead>
            <tbody>
                {% set accounts = dynamic_inactive_users | default(disabled_users | default([])) %}
                {% if accounts | length > 0 %}
                    {% for u in accounts %}
                    <tr class="table-row">
                        <td class="td-nowrap"><code>{{ u.username if u.username is defined else 'N/A' }}</code></td>
                        <td class="td-nowrap">
                            {# Fallback chain for Full Name: checks first+last name, then single name field, then username #}
                            {% if u.first_name is defined and u.last_name is defined and u.first_name and u.last_name and u.first_name != 'None' and u.last_name != 'None' %}
                                {{ u.first_name }} {{ u.last_name }}
                            {% elif u.name is defined and u.name and u.name != 'None' %}
                                {{ u.name }}
                            {% else %}
                                {{ u.username if u.username is defined else 'N/A' }}
                            {% endif %}
                        </td>
                        {# Shows department name, or defaults to 'General Operations' if blank/null (e.g., for students) #}
                        <td class="td-nowrap">{{ u.department if (u.department is defined and u.department and u.department != 'None' and u.department != 'null') else 'General Operations' }}</td>
                        {# Cleans up ISO timestamps: replaces the 'T' separator with a space and slices [:19]
                           to keep just "YYYY-MM-DD HH:MM:SS" without messy fractional microseconds. #}
                        <td class="td-nowrap">{{ (u.terminated_at | string | replace('T', ' '))[:19] if (u.terminated_at is defined and u.terminated_at and u.terminated_at != 'None') else 'N/A' }}</td>
                        <td class="td-nowrap"><span class="badge-speed">&lt; 1s (Instant)</span></td>
                        <td>
                            <div class="hold-cell">
                                {# Checks whether legal_hold is active; renders either the yellow Exempt badge + Release button,
                                   or "None" + Apply Hold button. Clicking the button triggers toggleLegalHold() below. #}
                                {% set is_hold = u.legal_hold if u.legal_hold is defined else false %}
                                {% if is_hold and is_hold != 'None' and is_hold != 'false' %}
                                    <span class="badge-hold">Exempt (Active Hold)</span>
                                    <button onclick="toggleLegalHold('{{ u.username if u.username is defined else '' }}', false, this)" class="btn-hold release">Release</button>
                                {% else %}
                                    <span class="badge-normal">None</span>
                                    <button onclick="toggleLegalHold('{{ u.username if u.username is defined else '' }}', true, this)" class="btn-hold apply">Apply Hold</button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% else %}
                    {# Empty-state row shown when no disabled/terminated accounts exist in PostgreSQL #}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 20px;">
                            No disabled or offboarded accounts present.
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        {# Only render the bottom page-switcher bar if there are rows to paginate #}
        {% if accounts | length > 0 %}
        <div class="pagination-wrapper">
            <div class="pagination-info" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls" id="paginationControls"></div>
        </div>
        {% endif %}
    </div>
</div>

<div class="footer">
    Automated HR Identity Management Pipeline • Nginx Service Active
</div>

<script>
// "async" lets this function send a web request to our backend API in the background
// without freezing the browser tab while Ansible updates PostgreSQL.
async function toggleLegalHold(username, holdState, btnElement) {
    // Lock the clicked button and change its text to "Updating..." so the admin can't accidentally double-click it
    if (btnElement) {
        btnElement.disabled = true;
        btnElement.innerText = "Updating...";
    }

    try {
        // "fetch('/api/hold', ...)" sends a POST request to our lightweight API wrapper behind Nginx,
        // passing the username and new true/false hold state—which runs our Legal Hold Ansible playbook!
        const response = await fetch('/api/hold', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: username, hold_state: holdState })
        });

        // Safely read any JSON error details returned by the backend (falls back to {} if empty)
        const data = await response.json().catch(() => ({}));

        if (response.ok) {
            // Once Ansible finishes updating PostgreSQL and re-rendering disabled.html, reload the page
            // so the updated yellow "Exempt (Active Hold)" badge appears immediately.
            window.location.reload();
        } else {
            // If the backend returned an error, alert the user and restore the button to its original state
            alert('Backend Error:\n' + (data.error || 'Execution failed. Check backend logs.'));
            if (btnElement) {
                btnElement.disabled = false;
                btnElement.innerText = holdState ? "Apply Hold" : "Release";
            }
        }
    } catch (err) {
        // Catch network connection drops and reset the button cleanly
        alert('Connection error: ' + err);
        if (btnElement) {
            btnElement.disabled = false;
            btnElement.innerText = holdState ? "Apply Hold" : "Release";
        }
    }
}

// Client-side pagination: slices the rendered table into clean 10-row pages in the browser
document.addEventListener("DOMContentLoaded", function() {
    const rowsPerPage = 10;
    const tableBody = document.querySelector("#disabledTable tbody");
    if (!tableBody) return;

    // Grab every user row (<tr class="table-row">) and turn them into a JavaScript array
    const rows = Array.from(tableBody.querySelectorAll("tr.table-row"));
    const totalRows = rows.length;

    // Stop early if there are no disabled accounts to paginate
    if (totalRows === 0) return;

    let currentPage = 1;
    // Math.ceil rounds up so e.g. 25 disabled users becomes 3 pages (10 + 10 + 5)
    const totalPages = Math.ceil(totalRows / rowsPerPage);

    // Shows only the 10 rows belonging to the clicked page number and hides all other rows
    function displayPage(page) {
        currentPage = page;
        // Calculate first and last row index for this page (Page 1 = rows 0..9, Page 2 = rows 10..19)
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        rows.forEach((row, index) => {
            if (index >= start && index < end) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });

        // Update the "Showing 1 to 10 of X entries" text label
        const currentEnd = Math.min(end, totalRows);
        const infoElem = document.getElementById("paginationInfo");
        if (infoElem) {
            infoElem.innerText = `Showing ${start + 1} to ${currentEnd} of ${totalRows} entries`;
        }

        // Redraw the page buttons to highlight the new active page
        renderControls();
    }

    // Dynamically builds the "< Prev", numbered page buttons, and "Next >" buttons
    function renderControls() {
        const controlsContainer = document.getElementById("paginationControls");
        if (!controlsContainer) return;

        controlsContainer.innerHTML = "";

        // "< Prev" button (disabled on Page 1)
        const prevBtn = document.createElement("button");
        prevBtn.className = "page-btn";
        prevBtn.innerText = "‹ Prev";
        prevBtn.disabled = currentPage === 1;
        prevBtn.onclick = () => displayPage(currentPage - 1);
        controlsContainer.appendChild(prevBtn);

        // Sliding window: keeps at most 5 page buttons visible at once so large tables don't overflow
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) {
            startPage = Math.max(1, endPage - 4);
        }

        // Render each page number button and highlight the active page
        for (let i = startPage; i <= endPage; i++) {
            const pageBtn = document.createElement("button");
            pageBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
            pageBtn.innerText = i;
            pageBtn.onclick = () => displayPage(i);
            controlsContainer.appendChild(pageBtn);
        }

        // "Next >" button (disabled on the last page)
        const nextBtn = document.createElement("button");
        nextBtn.className = "page-btn";
        nextBtn.innerText = "Next ›";
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.onclick = () => displayPage(currentPage + 1);
        controlsContainer.appendChild(nextBtn);
    }

    // Show Page 1 immediately when the page loads
    displayPage(1);
});
</script>

