<!-- Tells the web browser this is a modern HTML5 document -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Sets character encoding so special symbols (like •, ‹, ›) display properly -->
    <meta charset="UTF-8">
    <!-- Makes the layout scale cleanly on laptops, tablets, and phones -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Text shown on the browser tab -->
    <title>HR Identity Lifecycle Report - Active Identities</title>
    <style>
        /* ":root" stores reusable color swatches (--variable-name) so our dark-mode theme
           stays consistent across the entire page without repeating hex color codes. */
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --table-header: #0f172a;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-green: #22c55e;
            --accent-blue: #38bdf8;
            --accent-yellow: #facc15;
            --accent-red: #ef4444;
            --accent-purple: #c084fc;
            --border-color: #334155;
        }

        /* Base page styling: dark slate background, light text, and clean system fonts */
        html, body {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        /* Flexbox centers the dashboard and pushes the footer cleanly to the bottom of the screen */
        body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        /* Limits dashboard width to 1100px so tables stay easy to read on wide monitors */
        .container {
            max-width: 1100px;
            width: 100%;
            margin: 0 auto;
        }

        /* Top title bar: pushes the page title to the left and the green ACTIVE badge to the right */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .title-area h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
            color: #38bdf8;
        }

        .title-area .timestamp {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Pill-shaped green badge in the top-right showing total active users */
        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 0.5px;
            display: inline-block;
            background-color: rgba(34, 197, 94, 0.15);
            color: var(--accent-green);
            border: 1px solid var(--accent-green);
        }

        /* Navigation Bar linking the 4 static HTML pages generated by Ansible */
        .navbar {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
        }

        .nav-tab {
            color: var(--text-muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            transition: all 0.2s ease;
        }

        .nav-tab:hover {
            color: var(--text-main);
            border-color: var(--accent-blue);
        }

        /* Highlights whichever page tab the user is currently viewing */
        .nav-tab.active {
            color: #0f172a;
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        /* Rounded container boxes used for the Audit section and Employee table */
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-top: 0;
            margin-bottom: 16px;
            font-size: 18px;
            color: var(--text-main);
            letter-spacing: 0.3px;
        }

        /* Responsive 4-card grid: automatically fits 4 cards side-by-side on desktop and wraps on smaller screens */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }

        .metric-card {
            background-color: #0f172a;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .metric-title {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .metric-value {
            font-size: 24px;
            font-weight: 700;
            color: var(--accent-blue);
        }

        .metric-sub {
            font-size: 12px;
            color: var(--accent-green);
        }

        /* Red alert box that only appears if Ansible detects a desync between PostgreSQL, AD, and Authentik */
        .warning-banner {
            background-color: rgba(239, 68, 68, 0.15);
            border: 1px solid var(--accent-red);
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 24px;
            color: #fca5a5;
            font-size: 13px;
            line-height: 1.5;
        }

        .warning-banner strong {
            color: #ffffff;
        }

        /* Monospace tag styling for Active Directory Organizational Unit (OU) paths */
        .badge-ou {
            background-color: rgba(148, 163, 184, 0.12);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-family: "JetBrains Mono", Consolas, monospace;
            white-space: nowrap;
            display: inline-block;
        }

        /* Full-width data table styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        th {
            background-color: var(--table-header);
            color: var(--text-muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        td {
            font-size: 14px;
        }

        /* Keeps usernames and full names on a single line instead of wrapping awkwardly */
        .td-nowrap {
            white-space: nowrap;
        }

        /* Bottom bar holding "Showing 1 to 10 of X entries" on the left and page buttons on the right */
        .pagination-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .pagination-info {
            font-size: 13px;
            color: var(--text-muted);
        }

        .pagination-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .page-btn {
            background-color: var(--table-header);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .page-btn:hover:not(:disabled) {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .page-btn.active {
            background-color: var(--accent-blue);
            color: #0f172a;
            border-color: var(--accent-blue);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            padding-top: 20px;
            border-top: 1px solid rgba(51, 65, 85, 0.4);
            width: 100%;
            max-width: 1100px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="title-area">
            <h1>HR Identity Lifecycle Report</h1>
            <div class="timestamp">
                {# Jinja2 logic ({% ... %}): converts Ansible's 24-hour military clock into a 12-hour AM/PM clock #}
                {# "% 12" gets the remainder after dividing by 12 (so 14:00 becomes 2); midnight/noon (0) becomes 12 #}
                {% set hour_12 = ansible_facts['date_time']['hour'] | int % 12 %}
                {% set hour_12 = 12 if hour_12 == 0 else hour_12 %}
                {% set am_pm = 'PM' if (ansible_facts['date_time']['hour'] | int) >= 12 else 'AM' %}
                {# Double curly braces {{ ... }} stamp the exact generation date, time, and timezone onto the page #}
                Generated on {{ ansible_facts['date_time']['date'] }} at {{ "%02d" % hour_12 }}:{{ ansible_facts['date_time']['minute'] }}:{{ ansible_facts['date_time']['second'] }} {{ am_pm }} {{ ansible_facts['date_time']['tz'] }}
            </div>
        </div>
        <div class="status-badge">
            {# "| default([])" prevents an error if active_users_list is empty; "| length" counts how many users are in it #}
            ACTIVE IDENTITIES ({{ active_users_list | default([]) | length }})
        </div>
    </div>

    <!-- Top navigation tabs connecting all 4 static HTML dashboard pages -->
    <nav class="navbar">
        <a href="index.html" class="nav-tab">Overview</a>
        <a href="active.html" class="nav-tab active">Active Identities</a>
        <a href="disabled.html" class="nav-tab">Disabled Accounts</a>
        <a href="logs.html" class="nav-tab">Audit & System Logs</a>
    </nav>

    <!-- Multi-System Sync Reconciliation Audit Section -->
    <div class="card">
        <h2>Live System Synchronization Audit</h2>

        {# "{% set ... %}" creates clean local variables with safe "| default(...)" fallbacks
           so the webpage still renders cleanly even after a fresh reset when counts are zero. #}
        {% set total_active_count = active_users_list | default([]) | length %}
        {% set target_active = total_target_active | default(total_active_count) %}
        {% set accuracy = active_sync_accuracy_rate | default(100.0) %}
        {% set mismatches_cnt = total_active_mismatches | default(0) %}
        {% set ad_synced = ad_active_synced_count | default(target_active) %}
        {% set authentik_synced = authentik_active_synced_count | default(target_active) %}
        {% set ad_bad = ad_active_mismatches | default(0) %}
        {% set ak_bad = authentik_active_mismatches | default(0) %}

        <!-- 4-Card Verification Summary Grid -->
        <div class="metrics-grid">
            <div class="metric-card">
                <span class="metric-title">Sync Accuracy Rate</span>
                {# Turns the percentage green if 100.0%, or yellow if any desync mismatch was detected #}
                <span class="metric-value" style="color: {{ 'var(--accent-green)' if accuracy == 100.0 else 'var(--accent-yellow)' }};">
                    {{ accuracy }}%
                </span>
                <span class="metric-sub" style="color: var(--text-muted);">
                    {# Shows total verified endpoint checks across both AD and Authentik (target_active * 2) #}
                    {{ total_active_verified_matches | default(target_active * 2) }} / {{ total_active_probes_conducted | default(target_active * 2) }} Users Verified
                </span>
            </div>
            <div class="metric-card">
                <span class="metric-title">Active Directory</span>
                <span class="metric-value">{{ ad_synced }} / {{ target_active }}</span>
                {# "~" is Jinja2's text-joining symbol: glues the mismatch number onto ' Mismatches' #}
                <span class="metric-sub" style="color: {{ 'var(--accent-green)' if ad_bad == 0 else 'var(--accent-red)' }};">
                    {{ '100% Synced' if ad_bad == 0 else ad_bad ~ ' Mismatches' }}
                </span>
            </div>
            <div class="metric-card">
                <span class="metric-title">Authentik SSO</span>
                <span class="metric-value">{{ authentik_synced }} / {{ target_active }}</span>
                <span class="metric-sub" style="color: {{ 'var(--accent-green)' if ak_bad == 0 else 'var(--accent-red)' }};">
                    {{ '100% Synced' if ak_bad == 0 else ak_bad ~ ' Mismatches' }}
                </span>
            </div>
            <div class="metric-card">
                <span class="metric-title">Mismatches / Flagged</span>
                <span class="metric-value" style="color: {{ 'var(--accent-green)' if mismatches_cnt == 0 else 'var(--accent-red)' }};">
                    {{ mismatches_cnt }}
                </span>
                <span class="metric-sub" style="color: var(--text-muted);">
                    {{ 'Zero Desync Errors' if mismatches_cnt == 0 else 'Action Required' }}
                </span>
            </div>
        </div>

        {# Conditional warning banner: only rendered into the HTML if mismatches_cnt is greater than 0 #}
        {% if mismatches_cnt > 0 %}
        <div class="warning-banner">
            <strong>Sync Verification Warning:</strong> Detected {{ mismatches_cnt }} desynchronized active identity endpoint state(s).
            {# "| join(', ')" turns a list of out-of-sync usernames into a clean comma-separated string #}
            {% if active_authentik_mismatch_list is defined and active_authentik_mismatch_list | length > 0 %}
                <br/><strong>Authentik SSO Missing / Inactive:</strong> {{ active_authentik_mismatch_list | join(', ') }}
            {% endif %}
            {% if active_ad_mismatch_list is defined and active_ad_mismatch_list | length > 0 %}
                <br/><strong>Active Directory Missing / Disabled:</strong> {{ active_ad_mismatch_list | join(', ') }}
            {% endif %}
        </div>
        {% endif %}
    </div>

    <!-- Main Employee Directory Table -->
    <div class="card">
        <h2>Active Managed Employees</h2>
        <table id="activeTable">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>AD Location</th>
                </tr>
            </thead>
            <tbody>
                {# Check if there is at least 1 active user; if so, loop through every user and build a table row #}
                {% if active_users_list | default([]) | length > 0 %}
                    {% for u in active_users_list %}
                    <tr class="table-row">
                        <td class="td-nowrap"><code>{{ u.username | default('N/A') }}</code></td>
                        <td class="td-nowrap">
                            {# Smart fallback chain for Full Name: checks full_name first, then first+last name,
                               then single name field, and finally falls back to username so a cell is never blank. #}
                            {% if u.full_name is defined and u.full_name %}
                                {{ u.full_name }}
                            {% elif u.first_name is defined and u.last_name is defined and u.first_name and u.last_name and u.first_name != 'None' and u.last_name != 'None' %}
                                {{ u.first_name }} {{ u.last_name }}
                            {% elif u.name is defined and u.name and u.name != 'None' %}
                                {{ u.name }}
                            {% else %}
                                {{ u.username | default('N/A') }}
                            {% endif %}
                        </td>
                        <td>{{ u.email | default('N/A') }}</td>
                        <td>{{ u.department | default('N/A') }}</td>
                        {# Shows the user's specific AD Organizational Unit path, or 'OU=APEX K12' if not explicitly passed #}
                        <td><span class="badge-ou">{{ u.ad_location | default(u.ou | default('OU=APEX K12')) }}</span></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    {# Empty-state row shown right after a clean-slate environment reset #}
                    <tr>
                        <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 20px;">
                            No active employees retrieved from PostgreSQL HR DB.
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        {# Only render the bottom page-switcher bar if there are rows to paginate #}
        {% if active_users_list | default([]) | length > 0 %}
        <div class="pagination-wrapper">
            <div class="pagination-info" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
            <div class="pagination-controls" id="paginationControls"></div>
        </div>
        {% endif %}
    </div>
</div>

<div class="footer">
    Automated HR Identity Management Pipeline • Nginx Service Active
</div>

<!-- Client-side JavaScript pagination: breaks a 1,000-row table into clean 10-row pages
     right in the browser without needing a backend database server or PHP/Node.js. -->
<script>
// Wait until the entire HTML page has finished loading before running our table script
document.addEventListener("DOMContentLoaded", function() {
    const rowsPerPage = 10;
    const tableBody = document.querySelector("#activeTable tbody");
    if (!tableBody) return;

    // Grab every rendered user row (<tr class="table-row">) and convert them into a JavaScript list
    const rows = Array.from(tableBody.querySelectorAll("tr.table-row"));
    const totalRows = rows.length;
    
    // Stop early if the table is empty
    if (totalRows === 0) return;

    let currentPage = 1;
    // Math.ceil rounds up so e.g. 25 users becomes 3 pages (10 + 10 + 5)
    const totalPages = Math.ceil(totalRows / rowsPerPage);

    // Shows only the 10 rows belonging to the selected page number and hides all other rows
    function displayPage(page) {
        currentPage = page;
        // Calculate the first and last row index for this page (Page 1 = rows 0..9, Page 2 = rows 10..19)
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        // Loop through every row: show it ("") if it falls inside [start, end), otherwise hide it ("none")
        rows.forEach((row, index) => {
            if (index >= start && index < end) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });

        // Update the "Showing 1 to 10 of 1000 entries" text label
        const currentEnd = Math.min(end, totalRows);
        const infoElem = document.getElementById("paginationInfo");
        if (infoElem) {
            infoElem.innerText = `Showing ${start + 1} to ${currentEnd} of ${totalRows} entries`;
        }

        // Rebuild the page buttons to highlight the newly active page
        renderControls();
    }

    // Dynamically creates the "< Prev", numbered page buttons, and "Next >" buttons
    function renderControls() {
        const controlsContainer = document.getElementById("paginationControls");
        if (!controlsContainer) return;

        // Clear out old buttons before redrawing
        controlsContainer.innerHTML = "";

        // Build the "< Prev" button (disabled when already on Page 1)
        const prevBtn = document.createElement("button");
        prevBtn.className = "page-btn";
        prevBtn.innerText = "‹ Prev";
        prevBtn.disabled = currentPage === 1;
        prevBtn.onclick = () => displayPage(currentPage - 1);
        controlsContainer.appendChild(prevBtn);

        // Sliding window: keeps at most 5 page number buttons visible at a time so 100 pages don't overflow
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) {
            startPage = Math.max(1, endPage - 4);
        }

        // Create each numbered page button and highlight the active page in blue
        for (let i = startPage; i <= endPage; i++) {
            const pageBtn = document.createElement("button");
            pageBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
            pageBtn.innerText = i;
            pageBtn.onclick = () => displayPage(i);
            controlsContainer.appendChild(pageBtn);
        }

        // Build the "Next >" button (disabled when already on the final page)
        const nextBtn = document.createElement("button");
        nextBtn.className = "page-btn";
        nextBtn.innerText = "Next ›";
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.onclick = () => displayPage(currentPage + 1);
        controlsContainer.appendChild(nextBtn);
    }

    // Load Page 1 immediately when the webpage opens
    displayPage(1);
});
</script>

</body>
</html>